<navigation-bar title="收集信息" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="title">按模板查看信息</view>
    <view class="desc">每个模板下展示填写情况、填写人相关信息，并支持按时间排序。</view>

    <view class="record-list">
      <view wx:if="{{!groups.length}}" class="empty-card">暂无收集信息</view>
      <view wx:for="{{groups}}" wx:key="id" class="record-group">
        <view class="record-card" bindtap="onOpenGroup" data-id="{{item.id}}">
          <view>
            <view class="record-name">{{item.name}}</view>
            <view class="record-meta">共 {{item.count}} 条填写</view>
          </view>
          <view class="record-time">{{item.latestAt}}</view>
        </view>

        <view wx:if="{{activeTemplateId === item.id}}" class="submission-list">
          <button
            class="export-button"
            bindtap="onExportGroup"
            data-id="{{item.id}}"
            loading="{{exportingTemplateId === item.id}}"
            disabled="{{!!exportingTemplateId}}"
          >
            导出 Excel
          </button>

          <view wx:if="{{loadingRecords}}" class="empty-text">加载中...</view>
          <view wx:elif="{{!records.length}}" class="empty-text">暂无提交记录</view>
          <block wx:else>
            <block
              wx:for="{{records}}"
              wx:key="id"
              wx:for-item="record"
              wx:for-index="recordIndex"
            >
              <view
                wx:if="{{recordsExpanded || recordIndex < 3}}"
                class="submission-card {{record.hiddenValueCount ? 'submission-card-clickable' : ''}}"
                bindtap="onToggleRecord"
                data-id="{{record.id}}"
              >
                <view class="submission-header">
                  <view class="submission-time">{{record.createdAt}}</view>
                  <button
                    class="delete-button"
                    catchtap="onDeleteRecord"
                    data-id="{{record.id}}"
                    loading="{{deletingRecordId === record.id}}"
                    disabled="{{!!deletingRecordId || !!exportingTemplateId}}"
                  >
                    删除
                  </button>
                </view>
                <block
                  wx:for="{{record.values}}"
                  wx:key="key"
                  wx:for-item="valueItem"
                  wx:for-index="valueIndex"
                >
                  <view wx:if="{{record.expanded || valueIndex < 3}}" class="submission-row">
                    <text class="submission-key">{{valueItem.label}}</text>
                    <text class="submission-value">{{valueItem.value}}</text>
                  </view>
                </block>
                <view wx:if="{{record.hiddenValueCount}}" class="expand-hint">
                  <text wx:if="{{record.expanded}}">收起填写项</text>
                  <text wx:else>展开其余 {{record.hiddenValueCount}} 个填写项</text>
                  <text class="expand-arrow {{record.expanded ? 'expand-arrow-up' : ''}}">⌄</text>
                </view>
              </view>
            </block>

            <view wx:if="{{records.length > 3}}" class="records-expand-button" bindtap="onToggleRecords">
              <text wx:if="{{recordsExpanded}}">收起较早的提交记录</text>
              <text wx:else>查看其余 {{records.length - 3}} 条提交记录</text>
              <text class="expand-arrow {{recordsExpanded ? 'expand-arrow-up' : ''}}">⌄</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
