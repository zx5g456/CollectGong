<navigation-bar title="已有模板" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="title">已有模板</view>
    <view class="desc">查看创建过的问卷模板，并分享给填写人。</view>

    <view class="template-list">
      <view wx:if="{{!templates.length}}" class="empty-card">暂无模板</view>
      <view
        wx:for="{{templates}}"
        wx:key="id"
        class="template-swipe-item"
      >
        <view
          class="swipe-delete-action {{deletingTemplateId === item.id ? 'swipe-delete-action-disabled' : ''}}"
          catchtap="onDeleteTemplate"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <text>{{deletingTemplateId === item.id ? '删除中' : '删除'}}</text>
        </view>

        <view
          class="template-card"
          style="transform: translateX(-{{item.swipeOffset}}rpx);"
          bindtap="onOpenTemplate"
          bindtouchstart="onTemplateTouchStart"
          bindtouchend="onTemplateTouchEnd"
          bindtouchcancel="onTemplateTouchEnd"
          data-id="{{item.id}}"
        >
          <view class="template-main">
            <view class="template-info">
              <view class="template-name">{{item.name}}</view>
              <view class="template-meta">已收集 {{item.count}} 条 · {{item.updatedAt}}</view>
            </view>
            <view class="share-button-wrap">
              <view class="share-button-label">分享</view>
              <button
                class="share-button"
                open-type="share"
                catchtap="onShareTemplate"
                data-id="{{item.id}}"
                data-name="{{item.name}}"
                disabled="{{!!deletingTemplateId}}"
              ></button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
