<navigation-bar title="{{previewMode ? '查看模板' : '填写信息'}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="title">{{template.name || '填写信息'}}</view>
    <view wx:if="{{previewMode}}" class="desc">模板预览，仅展示填写项，不会提交信息。</view>
    <view wx:else class="desc">请根据表单要求填写信息，提交后发起人可以在收集信息中查看。</view>

    <view wx:if="{{loading}}" class="empty-card">加载中...</view>

    <view wx:elif="{{!template}}" class="empty-card">模板不存在或已失效</view>

    <view wx:elif="{{submitted}}" class="success-card">
      <view class="success-icon">✓</view>
      <view class="success-title">提交成功</view>
      <view class="success-desc">信息已发送给问卷发起人，现在可以关闭此页面了。</view>
    </view>

    <view wx:else class="form-card">
      <view wx:for="{{fields}}" wx:key="id" class="field-item">
        <view class="field-title">{{index + 1}}. {{item.title}}</view>
        <view wx:if="{{item.description}}" class="field-desc">{{item.description}}</view>
        <input
          class="field-input"
          type="{{item.type}}"
          placeholder="{{item.placeholder || '请输入'}}"
          value="{{formData[item.id]}}"
          disabled="{{previewMode}}"
          data-field-id="{{item.id}}"
          bindinput="onInputChange"
        />
      </view>

      <button
        wx:if="{{!previewMode}}"
        class="submit-button"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="onSubmit"
      >
        提交
      </button>
    </view>
  </view>
</scroll-view>
